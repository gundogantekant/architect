# PostgreSQL Configuration
ARCHITECT_PG_HOST=127.0.0.1
ARCHITECT_PG_PORT=3778
ARCHITECT_PG_DB=architect
ARCHITECT_PG_USER=architect
ARCHITECT_PG_PASSWORD=architect

# Connection string (alternative to individual vars above)
# DATABASE_URL=postgres://architect:change_me@127.0.0.1:3778/architect

# Connection pool
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000

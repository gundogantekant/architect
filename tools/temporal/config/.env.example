# Temporal PostgreSQL credentials
# Copy this file to .env and fill in your password:
#   cp tools/temporal/config/.env.example tools/temporal/config/.env
#   # then edit .env and set ARCHITECT_PG_PASSWORD
#
# These env vars mirror the ARCHITECT_PG_* convention used by the dashboard.
# If your shell already has ARCHITECT_PG_* set from the dashboard setup,
# the same values work here without modification.

ARCHITECT_PG_HOST=127.0.0.1
ARCHITECT_PG_PORT=3778
ARCHITECT_PG_DB=architect
ARCHITECT_PG_USER=architect
ARCHITECT_PG_PASSWORD=

# Temporal server address — used by workers, CLI tools, and namespace registration.
# Set this to the gRPC address of the running Temporal server.
TEMPORAL_ADDRESS=127.0.0.1:7233

# ─── Session Worker (UserSessionWorkflow) ────────────────────────────────────

# Anthropic API key — required by classify-intent, analyze-cloud, analyze-frontend activities.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for intent classification (default: claude-haiku-4-5-20251001).
# ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5-20251001

# Optional: override the Claude model used for cloud/frontend analysis (default: claude-haiku-4-5-20251001).
# ANTHROPIC_ANALYSIS_MODEL=claude-haiku-4-5-20251001

# Path to the architect portfolio directory (used by ragRetrieval for context).
# Typically: ~/.architect/portfolio
ARCHITECT_PORTFOLIO_DIR=~/.architect/portfolio

# Dashboard API base URL (used by ragRetrieval and dashboardDispatch).
# If unreachable, ragRetrieval falls back to tools/temporal/fixtures/backlog.json automatically.
DASHBOARD_URL=http://127.0.0.1:3777

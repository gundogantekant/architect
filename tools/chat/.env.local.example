# Cognito User Pool — required at startup; app will not start without this.
# AWS Console → Cognito → User Pools → [your pool] → Overview → User Pool ID
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito App Client ID — required for Amplify sign-in flows.
# AWS Console → Cognito → User Pools → [your pool] → App clients → [client] → Client ID
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Cognito OAuth domain (optional — only needed if using Hosted UI / social login)
# NEXT_PUBLIC_COGNITO_OAUTH_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# Temporal server address. Defaults to localhost:7233.
# Start with: temporal server start-dev --namespace architect
TEMPORAL_ADDRESS=localhost:7233

# Temporal namespace — must match the namespace registered by W-1210
TEMPORAL_NAMESPACE=architect

# PostgreSQL connection string — must point to a DB with migration 032 applied.
# Run: npm run db:migrate (from tools/dashboard/) before starting this app.
DATABASE_URL=postgresql://localhost:5432/architect

# Architect dashboard API base URL — used by EscalationBanner to report timeout events.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3777

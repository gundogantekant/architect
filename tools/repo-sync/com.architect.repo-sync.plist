<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.architect.repo-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>NODE_BINARY_PLACEHOLDER</string>
    <string>ARCHITECT_ROOT_PLACEHOLDER/tools/repo-sync/sync-runner.mjs</string>
    <string>--dashboard-url</string>
    <string>http://127.0.0.1:3777</string>
  </array>

  <key>WorkingDirectory</key>
  <string>ARCHITECT_ROOT_PLACEHOLDER</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>ARCHITECT_ROOT_PLACEHOLDER/tmp/repo-sync.log</string>

  <key>StandardErrorPath</key>
  <string>ARCHITECT_ROOT_PLACEHOLDER/tmp/repo-sync.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
